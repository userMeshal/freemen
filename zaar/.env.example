# ───────── قاعدة البيانات (PostgreSQL) ─────────
# من Neon / Supabase / Vercel Postgres — استخدم رابط الـ pooled connection
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# ───────── الأمان ─────────
# نص عشوائي طويل (32 حرفًا على الأقل):  openssl rand -base64 48
AUTH_SECRET=

# رابط المنصة النهائي (بدون / في الآخر)
NEXT_PUBLIC_SITE_URL=https://zaar.sa
# (اختياري) الدومين الجذر لتفعيل النطاقات الفرعية للمتاجر: متجر.zaar.sa
NEXT_PUBLIC_ROOT_DOMAIN=

# حساب إدارة زار (لوحة /hq) — كلمة المرور 12 حرفًا على الأقل
ZAAR_ADMIN_EMAIL=
ZAAR_ADMIN_PASSWORD=

# ───────── الذكاء الاصطناعي (Claude) ─────────
# بدون المفتاح تعمل المنصة بالمولّد المحلي (14 مجالًا جاهزًا)
ANTHROPIC_API_KEY=
# (اختياري) تغيير النموذج — الافتراضي claude-opus-5-5
ZAAR_AI_MODEL=

# ───────── الدفع ─────────
# 1 = صفحة دفع تجريبية للوسائل غير المضبوطة (الافتراضي خارج الإنتاج). في الإنتاج اتركه 0
ZAAR_TEST_PAYMENTS=0

# EdfaPay — مدى / فيزا / ماستركارد / Apple Pay
EDFAPAY_ENV=sandbox
EDFAPAY_API_KEY=
EDFAPAY_WEBHOOK_SECRET=

# تابي
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
# نص سري تضعه في ترويسة إشعارات تابي (Authorization)
TABBY_WEBHOOK_SECRET=

# تمارا
TAMARA_ENV=sandbox
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=

# ───────── المهام اليومية (التحويل اليومي) ─────────
# Vercel Cron يرسله تلقائيًا في ترويسة Authorization
CRON_SECRET=

# ───────── رفع صور المنتجات (Vercel Blob) ─────────
BLOB_READ_WRITE_TOKEN=
