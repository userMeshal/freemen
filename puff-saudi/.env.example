# ───────── قاعدة البيانات (PostgreSQL) ─────────
# من Neon / Supabase / Vercel Postgres — استخدم رابط الـ pooled connection
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# ───────── الأمان ─────────
# نص عشوائي طويل (32 حرفًا على الأقل):  openssl rand -base64 48
AUTH_SECRET=

# رابط الموقع النهائي (بدون / في الآخر)
NEXT_PUBLIC_SITE_URL=https://puffsaudi.cc

# حساب المدير الأول (يُنشأ عند تشغيل npm run db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ───────── EdfaPay ─────────
# sandbox للتجربة ، production للتشغيل الفعلي
EDFAPAY_ENV=sandbox
EDFAPAY_API_KEY=
# السر الذي تضعه في لوحة EdfaPay → Configuration → Webhook
EDFAPAY_WEBHOOK_SECRET=

# ───────── رفع الصور من لوحة التحكم (Vercel Blob) ─────────
BLOB_READ_WRITE_TOKEN=
